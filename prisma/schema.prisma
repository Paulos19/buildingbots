generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Supabase ou Neon (fortemente recomendado para Nextjs)
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Hash via bcryptjs
  role      String   @default("USER")
  createdAt DateTime @default(now())
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String   // URL do Vercel Blob
  demoUrl     String?
  sourceUrl   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
}
